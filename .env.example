# Серверный API-ключ OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Модель OpenAI, которую будет использовать серверное API приложения. Если пусто, используется gpt-4o-mini.
OPENAI_MODEL=
# URL проекта из Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# Публичный anon/publishable key из Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Секретный service_role key Supabase; используется только на сервере.
SUPABASE_SERVICE_ROLE_KEY=
