# Серверный ключ OpenAI. Никогда не используйте его в Client Components.
OPENAI_API_KEY=
# Идентификатор модели OpenAI, выбираемый владельцем проекта.
OPENAI_MODEL=gpt-4o-mini
# Публичный URL проекта Supabase. Допустим в браузерном коде.
NEXT_PUBLIC_SUPABASE_URL=
# Публичный anon/publishable key Supabase. Допустим в браузере при включённом RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Привилегированный серверный ключ Supabase. Никогда не передавайте в браузер.
SUPABASE_SERVICE_ROLE_KEY=
